  "info": {
    "_postman_id": "78f5c29f-9a3c-407a-b7c3-883d218de7ce",
    "name": "AlienVault OTX DirectConnect Indicators API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Open Threat Exchange (OTX) DirectConnect API provides programmatic access to the AlienVault OTX threat intelligence community. It exposes threat \"pulses\" (curated collections of indicators of compromise), indicator detail lookups (IPv4/IPv6, domain, hostname, URL, file hash, CVE), user and pulse search, and indicator submission. Authentication is by API key passed in the X-OTX-API-KEY request header. Endpoint paths and the authentication scheme are derived from the official AlienVault OTX Python SDK (OTXv2).\n\nContact Support:\n Name: AlienVault OTX (LevelBlue)",
      "type": "text/plain"
    }
  }
}