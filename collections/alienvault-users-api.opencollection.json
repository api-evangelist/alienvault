{
  "opencollection": "1.0.0",
  "info": {
    "name": "AlienVault OTX DirectConnect Indicators Users API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-OTX-API-KEY",
      "value": "{{X-OTX-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://otx.alienvault.com/api/v1/users/:username",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get user info"
        },
        {
          "info": {
            "name": "Subscribe to a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://otx.alienvault.com/api/v1/users/:username/subscribe/",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Subscribe to a user"
        },
        {
          "info": {
            "name": "Unsubscribe from a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://otx.alienvault.com/api/v1/users/:username/unsubscribe/",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Unsubscribe from a user"
        },
        {
          "info": {
            "name": "Follow a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://otx.alienvault.com/api/v1/users/:username/follow",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Follow a user"
        },
        {
          "info": {
            "name": "Unfollow a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://otx.alienvault.com/api/v1/users/:username/unfollow",
            "params": [
              {
                "name": "username",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Unfollow a user"
        }
      ]
    }
  ],
  "bundled": true
}